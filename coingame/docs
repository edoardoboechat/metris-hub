## 📦 ESTRUTURA DE DADOS

### PostgreSQL Schema
```sql
-- Users & Authentication
CREATE TABLE users (
  id UUID PRIMARY KEY,
  username VARCHAR(50) UNIQUE,
  email VARCHAR(100) UNIQUE,
  keycloak_id VARCHAR(255),
  role ENUM('PLAYER', 'ADMIN'),
  created_at TIMESTAMP,
  updated_at TIMESTAMP
);

-- Coins (treasure)
CREATE TABLE coins (
  id UUID PRIMARY KEY,
  latitude DECIMAL(10,8),
  longitude DECIMAL(11,8),
  created_at TIMESTAMP,
  collected_by UUID REFERENCES users(id),
  collected_at TIMESTAMP,
  is_active BOOLEAN DEFAULT true
);

-- User Wallets
CREATE TABLE wallets (
  id UUID PRIMARY KEY,
  user_id UUID UNIQUE REFERENCES users(id),
  balance DECIMAL(10,2),
  collected_coins_count INT,
  updated_at TIMESTAMP
);

-- Payment Idempotency
CREATE TABLE payment_events (
  id UUID PRIMARY KEY,
  user_id UUID REFERENCES users(id),
  stripe_payment_id VARCHAR(255) UNIQUE,
  amount DECIMAL(10,2),
  status ENUM('pending', 'success', 'failed'),
  created_at TIMESTAMP
);

-- Transaction History
CREATE TABLE transactions (
  id UUID PRIMARY KEY,
  user_id UUID REFERENCES users(id),
  coin_id UUID REFERENCES coins(id),
  amount DECIMAL(10,2),
  type ENUM('coin_collection', 'payment', 'purchase'),
  timestamp TIMESTAMP
);

-- Navigation Sessions
CREATE TABLE user_sessions (
  id UUID PRIMARY KEY,
  user_id UUID REFERENCES users(id),
  navigation_time_remaining INT, -- seconds
  expires_at TIMESTAMP
);
```

### Redis Data Structures
```
# Geo-Index for coins
geo_coins:zones (GEOHASH)
  Members: {coord: "lat,lng", score: geo_distance}

# Anti-Cheat tracking
anti_cheat:user:{id} (HASH)
  {last_lat: 35.6895, last_lng: 139.6917, last_time: 1711000000}

# Leaderboard (real-time)
leaderboard (ZSET - Sorted Set)
  {user_id: score (coin count)}
  Score range: 0 → 999999

# User cache
cache:user:{id} (HASH)
  {username, balance, collected_count}

# Session timers
session:user:{id} (STRING - TTL)
  Value: time_remaining_seconds
```

